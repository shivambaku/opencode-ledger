{
  "name": "@shivambaku/opencode-ledger",
  "version": "0.8.0",
  "description": "Experimental code review agent and TUI review ledger plugin for OpenCode.",
  "license": "MIT",
  "type": "module",
  "main": "./src/tui.tsx",
  "exports": {
    ".": "./src/tui.tsx",
    "./tui": "./src/tui.tsx"
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "opencode": ">=2.0.12 <3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shivambaku/opencode-ledger.git"
  },
  "bugs": {
    "url": "https://github.com/shivambaku/opencode-ledger/issues"
  },
  "homepage": "https://github.com/shivambaku/opencode-ledger#readme",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "code-review",
    "ledger"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.10 <0.6",
    "@opentui/solid": ">=0.5.10 <0.6",
    "solid-js": ">=1.9.10 <2"
  },
  "devDependencies": {
    "@opencode/client": "2.0.12",
    "@opencode/plugin": "2.0.12",
    "@opencode/theme": "2.0.12",
    "@opentui/core": "0.5.10",
    "@opentui/solid": "0.5.10",
    "@types/bun": "^1.3.3",
    "@types/node": "^24.10.1",
    "solid-js": "1.9.12",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
